{
  "name": "goreleaser-npm-publisher",
  "version": "1.6.0",
  "description": "Build and publish npm packages based on goreleaser output folder",
  "bin": "dist/bin.cjs",
  "main": "dist/index.cjs",
  "types": "dist/index.d.cts",
  "files": [
    "dist"
  ],
  "type": "module",
  "author": {
    "email": "evg.abramovitch@gmail.com",
    "name": "Evgeny Abramovich",
    "url": "https://github.com/evg4b"
  },
  "license": "MIT",
  "homepage": "https://github.com/evg4b/goreleaser-npm-publisher",
  "repository": {
    "type": "git",
    "url": "git@github.com:evg4b/goreleaser-npm-publisher.git"
  },
  "keywords": [
    "goreleaser",
    "npm",
    "npm-publish",
    "binary",
    "cli",
    "publish",
    "release"
  ],
  "bugs": {
    "url": "https://github.com/evg4b/goreleaser-npm-publisher/issues"
  },
  "readme": "README.md",
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "build": "NODE_ENV=production tsup",
    "build:dev": "NODE_ENV=development tsup",
    "start": "node dist/bin.cjs",
    "run": "tsup && node dist/bin.cjs",
    "format": "prettier --write .",
    "lint": "eslint .",
    "watch": "tsup --watch",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "es-toolkit": "^1.52.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-esbuild": "^0.4.0",
    "picocolors": "^1.1.1",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "verdaccio": "^6.10.5"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yargs": "^18.2.0"
  },
  "resolutions": {
    "esbuild@npm:^0.27.0": "^0.28.2",
    "test-exclude@npm:^7.0.1": "^8.0.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23"
  }
}
